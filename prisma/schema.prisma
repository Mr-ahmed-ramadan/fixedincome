// AGYAL — waitlist, partner requests and indicative yields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person who joined the waitlist, by email form or Google.
model WaitlistUser {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String? // E.164, e.g. +201001234567 (Google sign-ups add it after)
  locale          String    @default("ar") // ar | en
  provider        String    @default("email") // email | google
  emailVerifiedAt DateTime?
  welcomeSentAt   DateTime?
  verifySentAt    DateTime? // last confirmation email actually sent (throttles repeat sends)
  pendingEmail    String? // VERIFY | WELCOME when that email couldn't be sent yet (daily cap or provider error)
  unsubscribedAt  DateTime? // set by the unsubscribe link in our emails
  note            String? // optional message left when joining (read in /admin)
  loginCodeHash      String? // HMAC of the current 6-digit login code (never the code itself)
  loginCodeExpiresAt DateTime?
  loginCodeSentAt    DateTime? // throttles "send a new code"
  loginCodeTries     Int       @default(0)
  lastLoginAt        DateTime?
  referralCode    String    @unique
  referredById    String?
  referredBy      WaitlistUser?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       WaitlistUser[] @relation("Referrals")
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([referredById])
  @@index([createdAt])
  @@index([pendingEmail])
}

/// A broker, bank or other institution asking for an introductory call.
model PartnerRequest {
  id          String   @id @default(cuid())
  institution String
  type        String // BROKER | BANK | ASSET_MANAGER | OTHER | GENERAL (general enquiry)
  name        String
  role        String?
  email       String
  phone       String?
  message     String?
  locale      String   @default("en")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// One indicative yield shown on the landing page. Edited from /admin.
model YieldQuote {
  id             String   @id @default(cuid())
  currency       String // EGP | USD | EUR
  instrument     String // TBILL | BOND | SUKUK | EUROBOND | CORP
  labelEn        String // e.g. "3-month T-bill"
  labelAr        String // e.g. "أذون خزانة 3 شهور"
  tenorMonths    Int
  yieldPct       Float // annual yield before taxes and fees, e.g. 24.15
  couponsPerYear Int // 0 = paid at maturity (discount instruments)
  taxRatePct     Float? // withholding tax on the return, e.g. 20 for T-bills and bonds; null = unknown
  // Security details shown on its own page (all optional; T-bills have no coupon).
  couponRatePct  Float? // annual coupon, e.g. 7.6003
  maturityDate   DateTime?
  isin           String?
  minInvestment  Float? // minimum order in the security's currency
  // Optional bank equivalent for the same maturity (deposit or CD; tax-free for
  // Egyptian residents). Rows that have one appear in "side by side with banks".
  bankRatePct    Float?
  bankLabelEn    String? // e.g. "Bank A · 12-month deposit"
  bankLabelAr    String?
  bankAsOf       DateTime?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  asOf           DateTime
  updatedAt      DateTime @updatedAt

  @@index([currency, sortOrder])
}

/// Small key/value store for one-off bookkeeping (e.g. which seed version ran).
model AppMeta {
  key   String @id
  value String
}

/// A social channel in the launch plan (shown in /admin → Marketing).
model MarketingChannel {
  key       String   @id // facebook | instagram | tiktok | whatsapp | youtube | linkedin | x
  name      String
  handle    String?
  url       String?
  status    String   @default("TODO") // TODO | CREATED | ACTIVE
  audience  String?
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// One step of the marketing launch plan.
model MarketingTask {
  id        String    @id @default(cuid())
  week      Int // 0 = setup, then 1–4
  title     String
  channel   String    @default("all")
  kind      String    @default("CONTENT") // SETUP | CONTENT | OUTREACH | REVIEW
  owner     String    @default("YOU") // YOU | CLAUDE
  status    String    @default("TODO") // TODO | DOING | DONE
  dueDate   DateTime?
  link      String?
  notes     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([week, sortOrder])
}

/// Fixed-window counters for rate limits and the daily email budget.
model RateCounter {
  key     String   @id // e.g. "join:ip:1.2.3.4", "email:2026-10-23"
  count   Int
  resetAt DateTime
}

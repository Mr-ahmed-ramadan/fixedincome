# Copy to `.env` for local development. In production set these in Vercel →
# Project → Settings → Environment Variables (never commit real values).

# --- Database (Postgres) ---
# Local: a Postgres you run yourself. Production: the Neon/Vercel Postgres URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agyal"

# --- Site ---
APP_URL="http://localhost:3000"         # production: https://agyal.net
CONTACT_EMAIL="hello@agyal.net"
# Your Cal.com (or Calendly) booking page, shown to partners after they submit.
NEXT_PUBLIC_CAL_URL=""

# --- Auth.js (sessions + Google sign-in) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
# Google Cloud console → APIs & Services → Credentials → OAuth client.
# Authorised redirect URI: <APP_URL>/api/auth/callback/google
# Leave empty to hide the "Continue with Google" button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (Resend) ---
# console = print emails to the server log (no account needed).
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="AGYAL <hello@agyal.net>"


# --- Admin (/admin) ---
ADMIN_PASSWORD=""
